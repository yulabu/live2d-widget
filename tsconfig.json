{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "removeComments": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@framework/*": [
        "./build/CubismSdkForWeb-5-r.4/Framework/src/*"
      ],
      "@demo/*": [
        "./build/CubismSdkForWeb-5-r.4/Samples/TypeScript/Demo/src/*"
      ]
    }
  },
  "include": [
    "src",
    "build/CubismSdkForWeb-5-r.4/Core/live2dcubismcore.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}